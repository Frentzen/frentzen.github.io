source "https://rubygems.org"

# GitHub Pages builds the site with this gem set; pin to match the Pages build.
gem "github-pages", group: :jekyll_plugins

# Plugins (also bundled by github-pages, listed for local clarity).
gem "jekyll-feed"
gem "jekyll-seo-tag"
gem "jekyll-sitemap"

# Windows/JRuby and faster file watching; harmless elsewhere.
gem "webrick"
